# ============================================================
# Настройки RAG-ассистента
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
# ============================================================

# --- Векторная БД: "chromadb" или "weaviate" -----------------
VECTOR_DB=chromadb

# ChromaDB (локальный persistent-каталог на диске)
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=knowledge_base

# Weaviate (локальный, self-hosted, НЕ облачный сервис)
# Запуск локального Weaviate:
#   docker run -d -p 8080:8080 -p 50051:50051 cr.weaviate.io/semitechnologies/weaviate:1.28
WEAVIATE_URL=http://localhost:8080
WEAVIATE_COLLECTION=Paragraph

# --- LLM: "gigachat" или "proxyapi" --------------------------
LLM_PROVIDER=gigachat

# GigaChat (client secret приложения с developers.sber.ru)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# Отключить проверку SSL-сертификатов (если используются самоподписанные сертификаты)
GIGACHAT_VERIFY_SSL=false

# ProxyAPI (OpenAI-совместимый прокси-API)
PROXYAPI_URL=https://api.proxyapi.ru/openai/v1
PROXYAPI_KEY=
PROXYAPI_MODEL=gpt-4o-mini

# Температура модели LLM (0.0–2.0)
TEMPERATURE=0.2

# --- Эмбеддинги (всегда через ProxyAPI) ----------------------
PROXYAPI_EMBEDDING_MODEL=text-embedding-3-small

# --- Общие настройки RAG -------------------------------------
DATA_DIR=./data
CACHE_DB_PATH=./cache.sqlite3
TOP_K=5
HISTORY_SIZE=10
